    "resources/community/redfish-diff/LICENSE",
    "resources/community/redfish-diff/references/methodology.md",
    "resources/community/redfish-diff/scripts/analyze_redfish_diff.py",
    "resources/community/redfish-diff/scripts/tests/test_semantic_diff.py",
    "resources/community/web-backend/LICENSE",
    "resources/community/web-backend/references/plugin-patterns.md",
    "resources/community/web-backend/scripts/rackmount_web_backend_check.py",
    "resources/community/web-backend/scripts/test_rackmount_web_backend_check.py",
    "resources/interface-coverage/LICENSE",
    "resources/interface-coverage/scripts/doc-coverage.mjs",
    "resources/interface-coverage/scripts/doc-coverage.test.mjs",
