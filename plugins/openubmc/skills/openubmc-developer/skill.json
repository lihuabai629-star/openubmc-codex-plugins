  "keywords": [
    "openubmc",
    "source-analysis",
    "source-development",
    "code-structure",
    "repository-patterns",
    "component-development",
    "cross-component",
    "authored-source",
    "focused-verification"
  ],
  "categories": [
    "development"
  ],
  "usage": {
    "prompts": [
      "分析一个现有组件的源码需求，找到当前负责该行为的模块并给出建议",
      "按照现有仓库结构实现组件功能修改并完成聚焦验证",
      "评审一个跨组件源码方案，比较已有实现和正确扩展点",
      "修改控制运行行为的 authored 模型或配置，并验证生成链和直接消费者",
      "完成源码修改后，将已验证的源码事实交给 Build，并由 Build 产出 Upgrade 所需制品"
    ]
  }
}
