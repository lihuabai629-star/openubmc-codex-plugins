{
  "manifestVersion": 1,
  "name": "openubmc-debug",
  "version": "1.0.0",
  "description": "以只读方式组合源码、接口、对象、告警、日志和主机证据，定位或多环境对比 openUBMC 运行态问题并验证现场交付结果。",
  "author": "OpenUBMC Team",
  "license": "MulanPSL-2.0",
  "openubmc": {
    "minVersion": "1.0.0",
    "components": [
      "mdb",
      "dbus",
      "alarm",
      "runtime-logs",
      "field-debug"
    ]
  },
  "dependencies": {
    "python": ">=3.10",
    "jsonschema": ">=4.18",
    "ssh": "required for SSH-backed object, alarm, and OS-host evidence lanes",
    "sshpass": "conditional: required only for password-based SSH authentication",
    "rg": "conditional: preferred for local source evidence when CodeGraph is unavailable"
  },
  "relatedSkills": [
    "openubmc-developer",
    "openubmc-build",
    "openubmc-upgrade",
    "openubmc-live-patch",
    "openubmc-log-analyzer",
    "openubmc-environment-setup"
  ],
  "files": [
    "SKILL.md",
    "skill.json",
    "agents/openai.yaml",
    "references/agent-gateway.md",
    "references/alarm-access.md",
    "references/busctl-access.md",
    "references/components.md",
    "references/diagnostic-contract.md",
    "references/evidence-workflow.md",
    "references/file-access.md",
    "references/knowledge-routing.md",
    "references/logs.md",
    "references/mdbctl-access.md",
    "references/mechanism-debugging.md",
    "references/object-access.md",
    "references/openubmc-debug-compare-v1.schema.json",
    "references/optional-integrations.md",
    "references/remote-automation.md",
    "references/workflow.md",
    "scripts/_cli_common.py",
    "scripts/_comparison.py",
    "scripts/_debug_dump.py",
    "scripts/_json_common.py",
    "scripts/_minimal_telnet.py",
    "scripts/_preflight_checks.py",
    "scripts/_preflight_recommendations.py",
    "scripts/_remote_common.py",
    "scripts/_runtime_distribution.py",
    "scripts/_source_root.py",
    "scripts/_target_runtime_adapter.py",
    "scripts/_telnet_common.py",
    "scripts/_workflow_correlation.py",
    "scripts/_workflow_contracts.py",
    "scripts/_workflow_freshness.py",
    "scripts/_workflow_runtime.py",
    "scripts/_workflow_source.py",
    "scripts/active_alarms.py",
    "scripts/busctl_remote.py",
    "scripts/collect_logs.py",
    "scripts/compare_remote.py",
    "scripts/doctor.py",
    "scripts/mdbctl_remote.py",
