{
  "mcpServers": {
    "openubmc-target-runtime": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./scripts/openubmc-mcp-bootstrap.js",
        "runtime"
      ],
      "cwd": "./",
      "env_vars": [
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "CODEX_HOME",
        "OPENUBMC_TARGET_RUNTIME_STATE_DIR",
        "OPENUBMC_MDB_PROPERTY_CONTRACTS",
        "OPENUBMC_MCP_FORMAL_RUN",
        "OPENUBMC_MCP_CLIENT",
        "OPENUBMC_MCP_TASK_ID",
        "OPENUBMC_MCP_SESSION_ID",
        "OPENUBMC_MCP_MODEL_IDENTITY",
        "OPENUBMC_MCP_CODEX_IDENTITY",
        "OPENUBMC_MCP_SOURCE_COMMIT",
        "OPENUBMC_MCP_LIFECYCLE_DIR",
        "OPENUBMC_HOST_MEASUREMENTS_FILE",
        "OPENUBMC_HOST_PROVIDER_REPORT",
        "OPENUBMC_HOST_PROVIDER_REF",
        "OPENUBMC_HOST_EVIDENCE_KIND"
      ],
      "startup_timeout_sec": 600,
      "tool_timeout_sec": 900,
      "required": false
    },
    "openubmc-kb": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./scripts/openubmc-mcp-bootstrap.js",
        "kb"
      ],
      "cwd": "./",
      "env_vars": [
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "CODEX_HOME"
      ],
      "startup_timeout_sec": 600,
      "tool_timeout_sec": 900,
      "required": false
    },
    "openubmc-panel": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./panel/native.mjs"
      ],
      "cwd": "./",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 900,
      "env_vars": [
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "XDG_STATE_HOME",
        "OPENUBMC_TARGET_RUNTIME_STATE_DIR"
      ]
    },
    "openubmc-offline": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./scripts/openubmc-offline-mcp.js"
      ],
      "cwd": "./",
      "env_vars": [
        "OPENUBMC_PLUGIN_PYTHON",
        "OPENUBMC_OFFLINE_OUTPUT_DIR",
        "OPENUBMC_OFFLINE_TIMEOUT_SECONDS",
        "OPENUBMC_OFFLINE_MAX_CONCURRENCY",
        "XDG_STATE_HOME",
        "LOCALAPPDATA"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3700,
      "required": false
    }
  }
}
