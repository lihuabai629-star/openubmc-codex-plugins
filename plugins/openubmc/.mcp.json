{
  "mcpServers": {
    "openubmc-target-runtime": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./scripts/openubmc-mcp-bootstrap.js",
        "runtime"
      ],
      "cwd": "./",
      "env_vars": [
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "LOCALAPPDATA",
        "USERPROFILE",
        "CODEX_HOME",
        "OPENUBMC_WSL_DISTRO",
        "OPENUBMC_TARGET_RUNTIME_STATE_DIR",
        "OPENUBMC_MCP_FORMAL_RUN",
        "OPENUBMC_MCP_CLIENT",
        "OPENUBMC_MCP_TASK_ID",
        "OPENUBMC_MCP_SESSION_ID",
        "OPENUBMC_MCP_MODEL_IDENTITY",
        "OPENUBMC_MCP_CODEX_IDENTITY",
        "OPENUBMC_MCP_SOURCE_COMMIT",
        "OPENUBMC_MCP_LIFECYCLE_DIR"
      ],
      "startup_timeout_sec": 600,
      "tool_timeout_sec": 900,
      "required": true
    },
    "openubmc-kb": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./scripts/openubmc-mcp-bootstrap.js",
        "kb"
      ],
      "cwd": "./",
      "env_vars": [
        "XDG_CONFIG_HOME",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "LOCALAPPDATA",
        "USERPROFILE",
        "CODEX_HOME",
        "OPENUBMC_WSL_DISTRO"
      ],
      "startup_timeout_sec": 600,
      "tool_timeout_sec": 900,
      "required": true
    }
  }
}
